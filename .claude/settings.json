{
  "attribution": false,
  "autoMemoryEnabled": false,
  "disableClaudeAiConnectors": true,
  "crossSessionInbound": "refuse",
  "claudeMdExcludes": [
    "/home/*/.claude/CLAUDE.md",
    "/home/*/.claude/rules/**",
    "/Users/*/.claude/CLAUDE.md",
    "/Users/*/.claude/rules/**"
  ],
  "permissions": {
    "allow": [
      "Bash(gh auth status *)",
      "Bash(gh issue list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue status *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh label list *)"
    ],
    "deny": [
      "Bash(gh issue delete *)",
      "Bash(gh issue transfer *)",
      "Bash(gh gist *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "WebFetch|WebSearch|Bash|Read|Grep|Glob",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/clean_room_guard.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/clean_room_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
